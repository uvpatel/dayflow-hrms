# Database Configuration (Neon PostgreSQL)
# Replace this value. Confirm it is a disposable development branch before
# running db:migrate or db:seed; neither command was run in this implementation pass.
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
# Replace with at least 32 high-entropy characters. Never reuse this value
# across unrelated applications.
BETTER_AUTH_SECRET="replace-with-a-high-entropy-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Email verification is required by default in every environment.
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# Comma-separated first-party origins; each value must parse as a URL origin.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Social Authentication (Optional - leave empty if not configured)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional Email
# In development, omit both values to log verification/reset links locally.
# Production requires both values; use an HTTPS endpoint accepting a JSON
# payload with from, to, subject, text, and optional html fields.
EMAIL_PROVIDER_API_URL=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="notifications@dayflow.dev"
