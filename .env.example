# Database Configuration (Neon PostgreSQL)
# Replace this value. Confirm it is a disposable development branch before
# running db:migrate or db:seed; neither command was run in this implementation pass.
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration (required at startup in every environment)
# Replace with at least 32 high-entropy characters. Never reuse this value
# across unrelated applications.
BETTER_AUTH_SECRET="replace-with-a-high-entropy-secret-at-least-32-characters"
# The sole canonical application origin. Do not add a trailing slash, path,
# query, or fragment. Use http://localhost:3000 for local development and an
# explicit HTTPS origin for every preview or production deployment.
BETTER_AUTH_URL="http://localhost:3000"
# Email verification is required by default in every environment.
AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# Optional comma-separated additional first-party origins. BETTER_AUTH_URL is
# already trusted. Production entries must be exact HTTPS origins; never use *
# or https://*.vercel.app.
BETTER_AUTH_TRUSTED_ORIGINS=""
# Leave empty on Vercel: VERCEL=1 enables its trusted proxy headers. Set true
# only when a self-hosted reverse proxy overwrites forwarded host/proto headers.
AUTH_TRUST_PROXY_HEADERS=""

# Never define NEXT_PUBLIC_BETTER_AUTH_URL. The browser calls same-origin
# /api/auth and all auth secrets/configuration remain server-only.

# GitHub Authentication (required at startup in every environment)
# Configure the development OAuth callback as:
# http://localhost:3000/api/auth/callback/github
# Configure production as the actual BETTER_AUTH_URL origin followed by:
# /api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional Email
# In development, omit both values to log verification/reset links locally.
# Production verification requires all three values; use an HTTPS endpoint accepting a JSON
# payload with from, to, subject, text, and optional html fields.
EMAIL_PROVIDER_API_URL=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""
